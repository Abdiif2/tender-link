# APP_URL: The URL where this application is hosted (injected at runtime in Cloud Run).
APP_URL="http://localhost:3000"

# Dedicated HMAC-SHA256 signing secret for session access tokens (required in production, >= 32 random bytes)
SESSION_TOKEN_SECRET=""

# Optional comma-separated allowed browser origins for CSRF Origin validation
ALLOWED_ORIGINS=""

# Cloud SQL PostgreSQL runtime credentials are injected automatically by the platform:
# SQL_HOST, SQL_DB_NAME, SQL_USER, SQL_PASSWORD, SQL_ADMIN_USER, SQL_ADMIN_PASSWORD

# Chapa Payment Gateway (server-side only, never exposed to client)
CHAPA_SECRET_KEY="MY_CHAPA_SECRET_KEY"
CHAPA_WEBHOOK_SECRET="MY_CHAPA_WEBHOOK_SECRET"
CHAPA_BASE_URL="https://api.chapa.co/v1"
CHAPA_TEST_MODE="true"

# Optional Email / SMS / Object Storage configuration for Milestones 2, 4, and 6
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
S3_BUCKET_NAME=""
S3_REGION=""
